{
  "name": "weather-react",
  "version": "1.0.0",
  "description": "Weather-React",
  "private": true,
  "scripts": {
    "build": "set NODE_ENV='production' && webpack --mode=production",
    "build:dev": "set NODE_ENV='development' && webpack --mode=development",
    "dev": "set NODE_ENV='development' && webpack serve --mode=development",
    "test": "jest",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "type-check": "tsc --noEmit --strict --noUnusedLocals --noUnusedParameters --pretty",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TropinAB/Weather-React.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TropinAB/Weather-React/issues"
  },
  "homepage": "https://github.com/TropinAB/Weather-React#readme",
  "lint-staged": {
    "*.{js,ts}": "eslint --fix",
    "*.{js,ts,css,md,yml,html}": "prettier --write"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@eslint/css": "^0.6.0",
    "@eslint/js": "^9.24.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-jest": "^28.11.0",
    "globals": "^16.0.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "3.6.2",
    "style-loader": "^4.0.0",
    "text-encoding": "^0.7.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0"
  }
}
